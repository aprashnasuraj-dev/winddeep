{
  "tools": {
    "gitleaks": {
      "category": "secrets",
      "binary": "gitleaks",
      "args": [
        "git",
        "{target}",
        "--no-banner",
        "--redact"
      ],
      "parser": "lines",
      "timeout": 180,
      "retries": 1,
      "rate_limit": 1.0,
      "requires_scope": true,
      "description": "Gitleaks integration adapter.",
      "release_support": "bundled",
      "target_types": [
        "repo",
        "file",
        "url",
        "web"
      ],
      "runtime_strategy": "process",
      "ui_group": "secrets",
      "scan_default": true
    },
    "trufflehog": {
      "category": "secrets",
      "binary": "trufflehog",
      "args": [
        "filesystem",
        "{target}",
        "--json"
      ],
      "parser": "jsonl",
      "timeout": 180,
      "retries": 1,
      "rate_limit": 1.0,
      "requires_scope": true,
      "description": "TruffleHog integration adapter.",
      "release_support": "bundled",
      "target_types": [
        "repo",
        "file",
        "url",
        "web"
      ],
      "runtime_strategy": "process",
      "ui_group": "secrets",
      "scan_default": true
    },
    "semgrep": {
      "category": "secrets",
      "binary": "semgrep",
      "args": [
        "scan",
        "--config",
        "auto",
        "{target}",
        "--json"
      ],
      "parser": "lines",
      "timeout": 180,
      "retries": 1,
      "rate_limit": 1.0,
      "requires_scope": true,
      "description": "Semgrep integration adapter.",
      "release_support": "runtime",
      "target_types": [
        "repo",
        "file",
        "url",
        "web"
      ],
      "runtime_strategy": "process",
      "ui_group": "secrets",
      "scan_default": true
    },
    "git_secrets": {
      "category": "secrets",
      "binary": "git-secrets",
      "args": [
        "--scan",
        "{target}"
      ],
      "parser": "lines",
      "timeout": 180,
      "retries": 1,
      "rate_limit": 1.0,
      "requires_scope": true,
      "description": "git-secrets catalog adapter.",
      "release_support": "unsupported",
      "unsupported_reason": "Shell-centric upstream packaging is not yet certified as a self-contained Windows artifact.",
      "target_types": [
        "repo",
        "file",
        "url",
        "web"
      ],
      "runtime_strategy": "process",
      "ui_group": "secrets",
      "scan_default": false
    },
    "detect_secrets": {
      "category": "secrets",
      "binary": "detect-secrets",
      "args": [
        "scan",
        "{target}"
      ],
      "parser": "lines",
      "timeout": 180,
      "retries": 1,
      "rate_limit": 1.0,
      "requires_scope": true,
      "description": "detect-secrets integration adapter.",
      "release_support": "runtime",
      "target_types": [
        "repo",
        "file",
        "url",
        "web"
      ],
      "runtime_strategy": "process",
      "ui_group": "secrets",
      "scan_default": true
    },
    "repo_supervisor": {
      "category": "secrets",
      "binary": "repo-supervisor",
      "args": [
        "{target}"
      ],
      "parser": "lines",
      "timeout": 180,
      "retries": 1,
      "rate_limit": 1.0,
      "requires_scope": true,
      "description": "Repo Supervisor catalog adapter.",
      "release_support": "unsupported",
      "unsupported_reason": "Legacy/unreviewed project; retained only for catalog compatibility.",
      "target_types": [
        "repo",
        "file",
        "url",
        "web"
      ],
      "runtime_strategy": "process",
      "ui_group": "secrets",
      "scan_default": false
    },
    "gitrob": {
      "category": "secrets",
      "binary": "gitrob",
      "args": [
        "{target}"
      ],
      "parser": "lines",
      "timeout": 180,
      "retries": 1,
      "rate_limit": 1.0,
      "requires_scope": true,
      "description": "Gitrob catalog adapter.",
      "release_support": "unsupported",
      "unsupported_reason": "Legacy Ruby-based workflow is not certified for the self-contained Windows release.",
      "target_types": [
        "repo",
        "file",
        "url",
        "web"
      ],
      "runtime_strategy": "process",
      "ui_group": "secrets",
      "scan_default": false
    },
    "shhgit": {
      "category": "secrets",
      "binary": "shhgit",
      "args": [
        "--local",
        "{target}"
      ],
