{
  "tools": {
    "nmap": {
      "category": "network",
      "binary": "nmap",
      "args": [
        "-sT",
        "-Pn",
        "--top-ports",
        "100",
        "{target}"
      ],
      "parser": "lines",
      "timeout": 180,
      "retries": 1,
      "rate_limit": 1.0,
      "requires_scope": true,
      "description": "Nmap catalog adapter.",
      "release_support": "unsupported",
      "unsupported_reason": "Nmap redistribution/licensing and installer integration require separate OEM/license review; not bundled until approved.",
      "target_types": [
        "host",
        "domain",
        "url",
        "web"
      ],
      "runtime_strategy": "process",
      "ui_group": "network",
      "scan_default": false
    },
    "tshark": {
      "category": "network",
      "binary": "tshark",
      "args": [
        "-D"
      ],
      "parser": "lines",
      "timeout": 180,
      "retries": 1,
      "rate_limit": 1.0,
      "requires_scope": true,
      "description": "TShark catalog adapter.",
      "release_support": "unsupported",
      "unsupported_reason": "Wireshark/Npcap driver installation and license review require explicit admin/user consent outside the current portable contract.",
      "target_types": [
        "host",
        "domain",
        "url",
        "web"
      ],
      "runtime_strategy": "process",
      "ui_group": "network",
      "scan_default": false
    },
